# Desde a migração do APOD para science.nasa.gov/wp-json/wp/v2/apod-basic (11/2026),
# nenhuma rota deste app exige chave da NASA: nem o APOD nem a Image Library (busca por
# palavra-chave). NASA_API_KEY não é mais lida por src/lib/nasa.ts.
#
# Mantido aqui só por compatibilidade, caso algum upstream volte a exigir chave no
# futuro. Cadastro gratuito e instantâneo em https://api.nasa.gov/, se precisar.
NASA_API_KEY=
